# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-production-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=insuresphere_db
DB_USER=insuresphere_user
DB_PASSWORD=strong_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

# CORS Allowed Origins (React Frontend on Port 3000 / 5173)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Gemini API Key (Server-Side RAG & Claims Analysis)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional n8n Webhook URL for Automated Claims Triage Alerts
N8N_CLAIMS_WEBHOOK_URL=http://localhost:5678/webhook/insuresphere-fnol

# Gemini model (gemini-2.5-flash deprecated 2026-11-02; use a current model)
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT access-token lifetime in minutes (default 30; refresh cookie lasts 7 days)
JWT_ACCESS_TOKEN_MINUTES=30

# Persistent media storage for uploaded RAG documents (optional).
# Leave MEDIA_S3_BUCKET unset to store uploads on local disk (dev only;
# ephemeral on most PaaS hosts). Set it to use a private S3-compatible
# bucket (AWS S3, Cloudflare R2, MinIO) with signed URLs.
MEDIA_S3_BUCKET=
MEDIA_S3_REGION=ap-south-1
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_ACCESS_KEY=
<redacted>
